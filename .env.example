# ==============================================================
# OpenClaw – Environment Variables Example
# Copy this file to .env and fill in the values before running.
# ==============================================================

# ── Node / Runtime ─────────────────────────────────────────────
NODE_ENV=production

# ── Homebrew (set to 1 to avoid slow auto-updates inside the container) ──
HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_NO_INSTALL_CLEANUP=1

# ── AI Provider API Keys ────────────────────────────────────────
# At least one provider key is required for OpenClaw to work.

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic / Claude  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google Gemini  (https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Optional / Advanced ─────────────────────────────────────────
# Uncomment and set if needed by your deployment.

# Custom model overrides
# OPENCLAW_MODEL=gpt-4o

# Workspace directory inside the container (default shown)
# OPENCLAW_WORKSPACE=/home/node/.openclaw/workspace

# Proxy settings
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
