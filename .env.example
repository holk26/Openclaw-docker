# ==============================================================
# OpenClaw – Environment Variables Example
# Copy this file to .env and fill in the values before running.
#   cp .env.example .env
# ==============================================================

# ── Node / Runtime ─────────────────────────────────────────────
NODE_ENV=production

# ── Homebrew (set to 1 to avoid slow auto-updates inside the container) ──
HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_NO_INSTALL_CLEANUP=1

# ── Gateway / Networking ────────────────────────────────────────
# Secret token used to authenticate requests to the OpenClaw gateway.
OPENCLAW_GATEWAY_TOKEN=

# Port the gateway listens on inside the container (and exposed on the host).
OPENCLAW_GATEWAY_PORT=18789

# Port the bridge service listens on.
OPENCLAW_BRIDGE_PORT=18790

# Network interface the gateway binds to: "lan" (local network only) or "all".
OPENCLAW_GATEWAY_BIND=lan

# Allowed origins for the gateway control UI (comma-separated URLs).
# Example: https://agente.example.com
GATEWAY_CONTROLUI_ALLOWEDORIGINS=

# ── Authentication ──────────────────────────────────────────────
# Basic-auth credentials used to protect the gateway web interface.
AUTH_USERNAME=
AUTH_PASSWORD=

# ── Plugins ────────────────────────────────────────────────────
# Comma-separated list of plugins to load.
# Available plugins: discord, memory-core, whatsapp, telegram, ...
OPENCLAW_PLUGINS=

# ── WhatsApp Integration ────────────────────────────────────────
WHATSAPP_ENABLED=false

# ── Telegram Integration ────────────────────────────────────────
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# ── AI Provider API Keys ────────────────────────────────────────
# At least one provider key is required for OpenClaw to work.

# OpenAI  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic / Claude  (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Google Gemini  (https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter – unified gateway to many models  (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Kimi (Moonshot AI)  (https://platform.moonshot.cn/)
KIMI_API_KEY=

# ── Email / Notifications ───────────────────────────────────────
# Resend transactional email service  (https://resend.com/api-keys)
RESEND_API_KEY=

# K4X email account password (used by the K4X email skill)
K4X_EMAIL_PASSWORD=

# ── Container Build / System ────────────────────────────────────
# Extra apt packages to install at container startup (space-separated).
# Example: git curl nano
OPENCLAW_DOCKER_APT_PACKAGES=

# ── Optional / Advanced ─────────────────────────────────────────
# Uncomment and set if needed by your deployment.

# Custom default model (format: provider/model-name, e.g. openai/gpt-4o, anthropic/claude-3-5-sonnet)
# OPENCLAW_MODEL=openai/gpt-4o

# Workspace directory inside the container (default shown)
# OPENCLAW_WORKSPACE=/home/node/.openclaw/workspace

# Proxy settings
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
